{
  "name": "command-menu-chrome-extension",
  "version": "3.0.0",
  "description": "A keyboard-first command menu for Chrome",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.content-command.config.ts && vite build --config vite.content-tabs.config.ts && node scripts/post-build.js",
    "test": "node scripts/test-search.mjs && node --test tests/reliability.test.mjs && node scripts/test-palette-lifecycle.mjs",
    "check:extension": "node scripts/check-extension.mjs",
    "fixture:extension": "vite --host 127.0.0.1 --port 8769 --strictPort",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "test:benchmark": "node scripts/test-search.mjs --benchmark",
    "release:check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run test:e2e",
    "package:extension": "npm run release:check && node scripts/package-extension.mjs"
  },
  "keywords": [
    "chrome-extension",
    "command-palette",
    "productivity"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.1.24",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.10"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}

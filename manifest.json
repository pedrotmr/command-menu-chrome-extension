{
  "manifest_version": 3,
  "name": "Command Palette",
  "version": "1.0.0",
  "description": "A VS Code-style command palette for Chrome",
  "permissions": [
    "activeTab",
    "tabs",
    "bookmarks",
    "scripting",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Open Command Palette (Cmd+K)"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["modal.css"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "open-command-palette": {
      "suggested_key": {
        "default": "Ctrl+K",
        "mac": "Command+K"
      },
      "description": "Open Command Palette"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["modal.html"],
      "matches": ["<all_urls>"]
    }
  ]
}

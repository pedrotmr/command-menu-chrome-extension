{
  "manifest_version": 3,
  "name": "Keybar Tab Title Prototype",
  "version": "0.1.0",
  "permissions": ["scripting", "tabs", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Rename this tab" }
}

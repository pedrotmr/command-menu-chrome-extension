{
  "manifest_version": 3,
  "name": "Command Palette",
  "version": "2.0.0",
  "description": "A VS Code-style command palette for Chrome",
  "permissions": [
    "activeTab",
    "tabs",
    "bookmarks",
    "scripting",
    "notifications",
    "clipboardWrite"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Open Command Palette (Cmd+T)"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.tsx"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "open-command-palette": {
      "suggested_key": {
        "default": "Ctrl+T",
        "mac": "Command+T"
      },
      "description": "Open Command Palette"
    },
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy current page URL"
    },
    "toggle-previous-tab": {
      "suggested_key": {
        "default": "Ctrl+Tab",
        "mac": "Alt+Tab"
      },
      "description": "Toggle between current and previous tab"
    }
  }
}
